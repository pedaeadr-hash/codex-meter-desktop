<Window x:Class="CodexMeter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Meter"
        Width="236"
        Height="148"
        MinWidth="236"
        MinHeight="148"
        MaxWidth="236"
        MaxHeight="148"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown"
        Loaded="Window_OnLoaded"
        Closing="Window_OnClosing">
    <Border Background="#030303"
            BorderBrush="#0A0A0A"
            BorderThickness="5"
            CornerRadius="28"
            SnapsToDevicePixels="True">
        <Border.ContextMenu>
            <ContextMenu x:Name="WidgetMenu" Opened="WidgetMenu_OnOpened">
                <MenuItem Header="Atualizar agora" Click="Refresh_OnClick" />
                <MenuItem Header="Iniciar com o Windows" x:Name="StartupMenuItem" IsCheckable="True" Click="Startup_OnClick" />
                <Separator />
                <MenuItem Header="Ocultar" Click="Hide_OnClick" />
                <MenuItem Header="Fechar Codex Meter" Click="Exit_OnClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="61" />
                <RowDefinition Height="70" />
                <RowDefinition Height="7" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="22,22,18,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                        <GradientStop Color="#8EEA2A" Offset="0" />
                        <GradientStop Color="#E9FF91" Offset="0.20" />
                        <GradientStop Color="#8DFF0A" Offset="0.48" />
                        <GradientStop Color="#267B18" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="14,9,13,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Canvas Grid.Column="0" Width="50" Height="38">
                        <Ellipse Width="30" Height="30" Fill="#66FFFFFF" Stroke="#CCFFFFFF" StrokeThickness="1" Canvas.Left="0" Canvas.Top="3" />
                        <Ellipse Width="30" Height="30" Fill="#8AFFFFFF" Stroke="#CCFFFFFF" StrokeThickness="1" Canvas.Left="17" Canvas.Top="3" />
                    </Canvas>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PrimaryRemainingText}"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Light"
                                   HorizontalAlignment="Right"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <TextBlock Text="{Binding PrimaryCaption}"
                                   Foreground="#F4FFFFFF"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,8,12,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding PlanText}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{Binding WeeklyText}"
                           Foreground="#B4B4B4"
                           FontSize="11.5"
                           Margin="0,2,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{Binding ResetText}"
                           Foreground="#949494"
                           FontSize="10.5"
                           Margin="0,2,0,0" />

                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                        Width="34" Height="20"
                        Padding="0"
                        Margin="8,5,0,0"
                        VerticalAlignment="Center"
                        Background="#80D934"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Refresh_OnClick"
                        ToolTip="Atualizar dados">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <Ellipse Width="14" Height="14" Fill="White" HorizontalAlignment="Right" Margin="0,0,3,0" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Border Background="#1A1A1A" CornerRadius="0,0,20,20" />
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding WeeklyUsedPercent, Mode=OneWay}"
                             Height="7"
                             BorderThickness="0"
                             Foreground="#8DFF0A"
                             Background="#1A1A1A" />
            </Grid>
        </Grid>
    </Border>
</Window>
